  levelTitle: Emergency Power Backup - Charge / Backup Selector
  initialPage: 0
  pages:
  - title: LEVEL 28 | Emergency Power Backup
    explanation: Slot_01 Schottky 1N5819; Slot_02 220 Ohm; Slot_03 4700 uF capacitor;
      Slot_04 330 Ohm; Slot_05 1k bleed; Slot_06 SPDT. Fixed 5V, MAIN switch, green
      LED. SPDT A charge, COM capacitor+, B backup loads. Wire IDs in Level28_Exact_Wiring.csv.
    caption: PAGE 1/4 | SIX SLOTS | ELEVEN CONNECTIONS
    parts:
    - id: battery
      kind: 0
      position: {x: 0.09, y: 0.55}
