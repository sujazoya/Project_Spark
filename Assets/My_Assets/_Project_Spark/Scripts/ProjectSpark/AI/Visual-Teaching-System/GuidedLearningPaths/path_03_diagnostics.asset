    lesson: {fileID: 11400000, guid: 0de2525cbe650c24184cea5c866ce729, type: 2}
    requiredTargetType: 0
  - id: 02_shorts
    title: Investigate Short Circuits
    description: Use authoritative short flags, not invented wire paths.
    kind: 0
    lesson: {fileID: 11400000, guid: f823516699b03d842b40bffed0f5d396, type: 2}
    requiredTargetType: 0
  - id: 03_diagnosis
    title: Systematic Troubleshooting
    description: Follow source, return path, component and evaluator evidence.
    kind: 0
    lesson: {fileID: 11400000, guid: 6709ae36d53fa3a4eb056192b8cab1a3, type: 2}
    requiredTargetType: 0
  - id: 04_practice
    title: Verify a Power Objective
    description: Complete a power-range objective in a suitable level; change the
      target type in this course asset if needed.
