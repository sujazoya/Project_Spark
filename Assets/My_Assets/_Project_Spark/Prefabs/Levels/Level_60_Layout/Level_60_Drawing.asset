  levelTitle: The Grid Must Survive
  initialPage: 0
  pages:
  - title: 01 / Build the network
    explanation: Wire controls, battery converter, MPPT, the three sources and protected
      loads.
    caption: "46 WIRES  \u2022  72 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.6}
      label: CONTROL
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
