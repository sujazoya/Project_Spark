      position: {x: 0.7, y: 0.77}
      label: "FILTER 10 k\u03A9"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: cap
      kind: 9
      position: {x: 0.89, y: 0.55}
      label: "47 \xB5F  + / \u2212"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: negative
      kind: 9
      position: {x: 0.74, y: 0.23}
      label: "BATTERY \u2212"
