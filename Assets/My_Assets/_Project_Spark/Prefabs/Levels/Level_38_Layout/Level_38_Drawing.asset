  levelId: level_38
  levelTitle: One Press, One Count
  initialPage: 0
  pages:
  - title: 01 / Wire the debounce circuit
    explanation: "W01 Battery_positive \u2192 SW_IN. W02 SW_OUT \u2192 FEED_IN. W03
      FEED_OUT \u2192 PULLDOWN_IN. W04 FEED_OUT \u2192 FILTER_IN. W05 PULLDOWN_OUT
      \u2192 Battery_negative. W06 FILTER_OUT \u2192 CAP_PLUS. W07 CAP_MINUS \u2192
      Battery_negative."
    caption: "5 V SUPPLY  \u2022  RAW AT FEED OUT  \u2022  FILTERED AT CAP +"
    parts:
    - id: positive
      kind: 9
      position: {x: 0.08, y: 0.77}
      label: BATTERY +
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: switch
      kind: 9
      position: {x: 0.25, y: 0.77}
      label: PUSHBUTTON
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: feed
