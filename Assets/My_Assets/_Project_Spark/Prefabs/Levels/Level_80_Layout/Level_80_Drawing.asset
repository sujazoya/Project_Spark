  levelId: level_80
  levelTitle: Command the Light
  initialPage: 0
  pages:
  - title: 01 / Build the optical control network
    explanation: Wire power, transmitter, ring heaters, receiver and safety. Connect
      W078 last.
    caption: "126 WIRES  \u2022  194 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: POWER
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: CONTROL
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: SAFETY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
