      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 04 / Restore trusted receiver power
    explanation: Remove W078 during live traffic. Verify source decay and shutter
      closure, reconnect, recalibrate, reset and run fresh traffic.
    caption: "W078  \u2022  INDEPENDENT SHUTTER"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: SHUTTER
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
