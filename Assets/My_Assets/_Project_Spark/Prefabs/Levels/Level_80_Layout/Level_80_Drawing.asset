      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 03 / Transmit and qualify data
    explanation: Measure all four power budgets, recover four clocks and qualify
      Logic, Memory, I/O and Sensor traffic.
    caption: "POWER  \u2022  EYE  \u2022  BER / FEC"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: BUDGET
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: CLOCK
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: DATA
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
