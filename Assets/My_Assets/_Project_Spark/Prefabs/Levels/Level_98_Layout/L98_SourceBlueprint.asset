  objectives:
  - Id: 01
    Title: Assemble
    Criterion: All 56 correct placements
  - Id: 02
    Title: Route
    Criterion: 74 route tasks, 16 vias, verified netlist
  - Id: 03
    Title: Calibrate
    Criterion: Protected rails, voltage and current calibration
  - Id: 04
    Title: Transient
    Criterion: Qualified droop overshoot recovery
  - Id: 05
    Title: Repair
    Criterion: ESR, open via and Kelvin faults repaired then new run
  - Id: 06
    Title: W075
    Criterion: Physical disconnection, safe inhibit, repair, explicit reset and fresh
      qualification
  faults:
  - Id: A
    Title: Degraded polymer capacitor ESR
    Mechanism: Worse voltage droop and heating
    Evidence: Verified electrical topology; Fresh measured transient response; Authorized
      repair transaction
    Repair: Replace faulted capacitor; retest
  - Id: B
    Title: Open ground return via
    Mechanism: Ground bounce and ripple
    Evidence: Verified electrical topology; Fresh measured transient response; Authorized
      repair transaction
    Repair: Restore actual via connectivity
  - Id: C
    Title: Kelvin sense fault
    Mechanism: Incorrect measured load rail
    Evidence: Verified electrical topology; Fresh measured transient response; Authorized
      repair transaction
    Repair: Repair sensor trace; recalibrate
  safety:
    JumperId: W075
    LogicalSource: L98_LoadRailSupervisor_U8.TRUSTED_LOAD_RAIL_VALID_OUT
    LogicalDestination: L98_PowerIntegritySafety_U9.TRUSTED_LOAD_RAIL_VALID_IN
    PhysicalPinStatus: UNASSIGNED
    NetlistStatus: SCHEMATIC_REQUIRED
    StartsDisconnected: 1
