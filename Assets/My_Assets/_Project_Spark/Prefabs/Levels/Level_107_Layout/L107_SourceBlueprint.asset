  objectives:
  - Id: 01
    Title: Assembly
    Criterion: Install all 112 components and verify actual contacts
  - Id: 02
    Title: Electrical Network
    Criterion: Complete 148 approved player routes, 46 vias, install W149
  - Id: 03
    Title: Firmware Recovery
    Criterion: Authenticate recovery bank and restore corrupted primary
  - Id: 04
    Title: POST & Resilience
    Criterion: Configure boot, pass POST and interrupted-update recovery
  - Id: 05
    Title: Three Repairs
    Criterion: Verify F1, F2 and F3 and complete fresh qualification
  - Id: 06
    Title: W149 Safety Recovery
    Criterion: Disconnect, inhibit, reconnect, revalidate, reset, certify
  faults:
  - Id: F1
    Title: U6 Primary SPI Chip-Select Contact
    Mechanism: OPEN_SPI_CS
    Evidence: 
    Repair: Qualified solder contact restoration
  - Id: F2
    Title: Corrupted Primary Firmware Image
    Mechanism: FIRMWARE_CORRUPTION
    Evidence: 
    Repair: Authenticated rewrite from protected U7 recovery bank
  - Id: F3
    Title: Recovery Request Pull-Up Failure
    Mechanism: RECOVERY_INPUT
    Evidence: 
    Repair: Replace faulty recovery request resistor
  safety:
    JumperId: W149
    LogicalSource: FirmwareTrustMonitor.TRUSTED_FIRMWARE_READY_OUT
    LogicalDestination: IndependentPlatformSafetySupervisor.TRUSTED_FIRMWARE_READY_IN
    PhysicalPinStatus: UNASSIGNED
    NetlistStatus: 
    StartsDisconnected: 1
