  levelId: level_51
  levelTitle: Predict the Failure
  initialPage: 0
  pages:
  - title: 01 / Wire the diagnostic rig
    explanation: Place the shunt in series with the motor. Run its two independent
      sense leads to the controller.
    caption: "19 WIRES  \u2022  32 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.51}
      label: 5 V / RETURN
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.51, y: 0.51}
      label: DRIVER / SHUNT
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.51}
      label: SENSORS
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.51}
      - {x: 0.43, y: 0.51}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.51}
      - {x: 0.75, y: 0.51}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 02 / Capture a healthy reference
    explanation: Capture the baseline once speed, current, temperature and vibration
      settle.
    caption: "45 RPM  \u2022  STABLE SAMPLES"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.51}
      label: ENCODER
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.51, y: 0.51}
      label: BASELINE
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.51}
      label: HEALTH
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.51}
      - {x: 0.43, y: 0.51}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.51}
      - {x: 0.75, y: 0.51}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 03 / Compare fault signatures
    explanation: An eccentric rotor produces vibration at shaft frequency. Bearing
      wear adds irregular vibration, higher current and heating.
    caption: SYNCHRONOUS VS IRREGULAR VIBRATION
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.51}
      label: ROTOR
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.51, y: 0.51}
      label: SIGNATURE
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.51}
      label: BEARING
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.51}
      - {x: 0.43, y: 0.51}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.51}
      - {x: 0.75, y: 0.51}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 04 / Prevent and repair
    explanation: Stop during the warning window. Open the guard, replace the bearing,
      correct the balance, reset and verify at 45 RPM.
    caption: "WARNING  \u2022  STOP  \u2022  VERIFY"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.51}
      label: TREND
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.51, y: 0.51}
      label: SERVICE
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.51}
      label: CERTIFY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
