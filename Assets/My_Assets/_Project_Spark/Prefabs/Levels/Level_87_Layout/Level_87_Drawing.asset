      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 03 / Hold artificial gravity
    explanation: The physical habitat scenario uses a 45 m radius. Balance the rotor,
      reach 3 RPM and maintain habitat power, cooling and optical data under changing
      load.
    caption: "3 RPM  \u2022  0.453 g"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: BALANCE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: SPIN
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: LOAD
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
