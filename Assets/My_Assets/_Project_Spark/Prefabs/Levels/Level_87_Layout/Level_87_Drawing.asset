      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 04 / Recover trusted feedback
    explanation: During the supervised low-speed trial remove W137. Watch the controlled
      rundown. Reconnect, recalibrate and reset, then qualify a fresh complete run.
    caption: "W137  \u2022  P019 \u2192 P135"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
