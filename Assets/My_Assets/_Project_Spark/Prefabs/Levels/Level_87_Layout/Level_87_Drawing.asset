  levelTitle: The Gravity Engine
  initialPage: 0
  pages:
  - title: 01 / Wire the control network
    explanation: Connect the numbered ports on their equipment. Verify protected
      5 V, the independent relay, E-stop and the primary W137 sensor.
    caption: 158 DIRECT WIRES
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: WIRE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
