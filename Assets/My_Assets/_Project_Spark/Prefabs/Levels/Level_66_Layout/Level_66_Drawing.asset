  - title: 03 / Isolate and repair
    explanation: Stop, verify isolation and lock out before opening the guard. Extract,
      replace, align and verify torque.
    caption: "ZERO SPEED  \u2022  LOCKOUT"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.66}
      label: ISOLATE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.66, y: 0.66}
