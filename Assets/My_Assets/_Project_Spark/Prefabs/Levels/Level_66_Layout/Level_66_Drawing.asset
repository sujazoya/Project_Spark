  pages:
  - title: 01 / Wire the condition network
    explanation: Connect the VFD, measurements, diagnostics and safety. Install W70
      last.
    caption: "70 WIRES  \u2022  110 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.66}
      label: DRIVE
