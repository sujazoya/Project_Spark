  levelId: level_44
  levelTitle: Find Home
  initialPage: 0
  pages:
  - title: 01 / Wire the encoder
    explanation: W01 supply + to decoder +. W02 supply return to decoder return.
      W03 ENC Z to DEC Z. W04 ENC A to DEC A. W05 ENC B to DEC B. Fit the A/B wires
      last so you can swap them later.
    caption: "A AND B  \u2022  Z INDEX  \u2022  5 V"
    parts:
    - id: source
      kind: 9
      position: {x: 0.12, y: 0.8}
      label: 5 V + RETURN
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    - id: encoder
      kind: 9
      position: {x: 0.14, y: 0.48}
      label: ENCODER
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: decoder
      kind: 9
      position: {x: 0.82, y: 0.48}
      label: DECODER
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: phaseA
      kind: 9
      position: {x: 0.47, y: 0.64}
      label: "A \u2192 A"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: phaseB
      kind: 9
      position: {x: 0.47, y: 0.3}
      label: "B \u2192 B"
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    - id: index
      kind: 9
      position: {x: 0.47, y: 0.48}
      label: Z INDEX
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
