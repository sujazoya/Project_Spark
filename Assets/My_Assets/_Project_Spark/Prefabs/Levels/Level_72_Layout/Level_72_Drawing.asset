  m_Script: {fileID: 11500000, guid: 7dbcf2efd0d400c45bb9124777514e60, type: 3}
  m_Name: Level_72_Drawing
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.UI.VisualTeaching.SparkLevelDrawingAsset
  levelId: level_72
  levelTitle: Layer by Layer
  initialPage: 0
  pages:
  - title: 01 / Wire the deposition workbench
    explanation: Connect control power and I/O, then install W94 last at the purge
      feedback terminals.
    caption: "94 WIRES  \u2022  146 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: POWER
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: PURGE
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: SAFETY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.71, y: 0.71}
      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 02 / Commission and cycle
    explanation: "Load and clamp a wafer after pumpdown. Stabilize heat and pressure.
      Demonstrate three A\u2013purge\u2013B\u2013purge cycles."
    caption: "HEAT  \u2022  DOSE  \u2022  PURGE"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: CONDITION
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: DOSE
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: VERIFY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.71, y: 0.71}
      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 03 / Inspect the film
    explanation: Run Auto Batch and measure the conformal film. Diagnose purge restriction,
      heater drift and the stuck A valve.
    caption: "120 CYCLES  \u2022  12.0 nm"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: DEPOSIT
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: INSPECT
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: REPAIR
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.71, y: 0.71}
      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 04 / Restore purge feedback
    explanation: During Purge A remove W94. Reconnect, recalibrate and verify purge.
      Reset and certify a fresh wafer.
    caption: "W94  \u2022  DOSE INHIBIT  \u2022  RECERTIFY"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: ISOLATE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: RECONNECT
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: CERTIFY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
