  levelId: level_35
  levelTitle: Bridge Balance - Find the Hidden Fault
  initialPage: 0
  pages:
  - title: 01 / Wire and capture the baseline
    explanation: "W01 Battery_positive \u2192 LU_IN. W02 Battery_positive \u2192
      RU_IN. W03 LU_OUT \u2192 LL_IN. W04 RU_OUT \u2192 RL_IN. W05 LL_OUT \u2192
      Battery_negative. W06 RL_OUT \u2192 Battery_negative. Each midpoint should
      read 2.50 V relative to Battery \u2212."
    caption: "TWO PARALLEL DIVIDERS \u2022 5 V \u2022 FOUR 1 k\u03A9 RESISTORS"
    parts:
    - id: supply
      kind: 9
      position: {x: 0.1, y: 0.55}
      label: BATTERY +
      color: {r: 0.98, g: 0.34, b: 0.4, a: 1}
    - id: lu
      kind: 1
      position: {x: 0.33, y: 0.77}
      label: "LU 1 k\u03A9"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: lm
      kind: 9
      position: {x: 0.51, y: 0.77}
      label: LEFT 2.50 V
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: ll
      kind: 1
      position: {x: 0.7, y: 0.77}
      label: "LL 1 k\u03A9"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: ru
      kind: 1
      position: {x: 0.33, y: 0.34}
      label: "RU 1 k\u03A9"
      color: {r: 0.99, g: 0.71, b: 0.28, a: 1}
    - id: rm
      kind: 9
      position: {x: 0.51, y: 0.34}
      label: RIGHT 2.50 V
      color: {r: 0.99, g: 0.71, b: 0.28, a: 1}
    - id: rl
      kind: 1
      position: {x: 0.7, y: 0.34}
      label: "RL 1 k\u03A9"
      color: {r: 0.99, g: 0.71, b: 0.28, a: 1}
    - id: return
      kind: 9
      position: {x: 0.9, y: 0.55}
      label: "BATTERY \u2212"
      color: {r: 0.24, g: 0.69, b: 1, a: 1}
    wires:
    - points:
