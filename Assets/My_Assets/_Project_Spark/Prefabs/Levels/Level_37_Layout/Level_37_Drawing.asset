      - {x: 0.915, y: 0.66}
      energized: 0
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
  - title: 02 / Connect the Kelvin meter
    explanation: "W06 SENSE_PLUS \u2192 CONNECTOR_PLUS. W07 SENSE_MINUS \u2192 CONNECTOR_MINUS.
      Leave the FORCE wires connected to the same connector terminals. At 40.0 mA,
      0.20 V across the connector gives 5 \u03A9. Press READ KELVIN."
    caption: "KELVIN = CONNECTOR VOLTAGE \xF7 TEST CURRENT"
    parts:
    - id: positive
      kind: 9
      position: {x: 0.075, y: 0.66}
      label: BATTERY +
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: limiter
      kind: 1
      position: {x: 0.24, y: 0.66}
