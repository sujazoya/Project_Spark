  levelId: level_37
  levelTitle: Kelvin Test
  initialPage: 0
  pages:
  - title: 01 / Measure the FORCE loop
    explanation: "W01 Battery_positive \u2192 LIMIT_IN. W02 LIMIT_OUT \u2192 LEAD_PLUS_IN.
      W03 LEAD_PLUS_OUT \u2192 CONNECTOR_PLUS. W04 CONNECTOR_MINUS \u2192 LEAD_RETURN_IN.
      W05 LEAD_RETURN_OUT \u2192 Battery_negative. Press READ LOOP. The 100 \u03A9
      limiter sets the test current and sits outside the two-wire voltage measurement."
    caption: "TWO-WIRE = 10 \u03A9 + 5 \u03A9 + 10 \u03A9 = 25 \u03A9"
    parts:
    - id: positive
      kind: 9
      position: {x: 0.075, y: 0.66}
      label: BATTERY +
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: limiter
      kind: 1
      position: {x: 0.24, y: 0.66}
      label: "LIMITER 100 \u03A9"
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: lead
      kind: 1
      position: {x: 0.405, y: 0.66}
      label: "LEAD 10 \u03A9"
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: connector
      kind: 1
      position: {x: 0.57, y: 0.66}
      label: "CONNECTOR 5 \u03A9"
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: return-lead
      kind: 1
      position: {x: 0.735, y: 0.66}
      label: "RETURN 10 \u03A9"
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: negative
      kind: 9
      position: {x: 0.915, y: 0.66}
      label: "BATTERY \u2212"
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    wires:
    - points:
      - {x: 0.075, y: 0.66}
      - {x: 0.195, y: 0.66}
      energized: 0
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - points:
      - {x: 0.285, y: 0.66}
      - {x: 0.36, y: 0.66}
      energized: 0
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - points:
      - {x: 0.45, y: 0.66}
      - {x: 0.525, y: 0.66}
      energized: 0
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - points:
