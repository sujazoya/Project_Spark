  levelId: level_40
  levelTitle: The Long Run
  initialPage: 0
  pages:
  - title: 01 / Wire the current loop
    explanation: "W01 LOOP_POS \u2192 TX_IN. W02 TX_OUT \u2192 CABLE_IN. W03 CABLE_OUT
      \u2192 LINE_IN. W04 LINE_OUT \u2192 RX_IN. W05 RX_OUT \u2192 LOOP_RETURN. The
      empty tank sends 4 mA and the 250 \u03A9 receiver reads 1.00 V."
    caption: 4 mA IS LIVE ZERO
    parts:
    - id: positive
      kind: 9
      position: {x: 0.1, y: 0.72}
      label: 12 V +
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: transmitter
      kind: 9
      position: {x: 0.32, y: 0.72}
      label: "4\u201320 mA TX"
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: cable
      kind: 1
      position: {x: 0.58, y: 0.72}
      label: "50 \u03A9 CABLE"
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: line
      kind: 9
      position: {x: 0.81, y: 0.52}
      label: LINE CLOSED
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: receiver
      kind: 1
      position: {x: 0.58, y: 0.32}
      label: "250 \u03A9  RX 1.00 V"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: return
      kind: 9
      position: {x: 0.1, y: 0.32}
      label: LOOP RETURN
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    wires:
    - points:
      - {x: 0.1, y: 0.72}
      - {x: 0.275, y: 0.72}
      energized: 0
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
