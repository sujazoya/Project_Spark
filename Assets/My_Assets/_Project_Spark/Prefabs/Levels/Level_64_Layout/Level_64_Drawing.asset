      - {x: 0.75, y: 0.64}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 04 / Recover and certify
    explanation: Prove upstream backup for a stuck breaker. Restore PMU B, resynchronize
      and repeat the selective fault.
    caption: "BREAKER FAILURE  \u2022  W62 PMU LOSS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.64}
      label: BACKUP
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.64, y: 0.64}
      label: REPAIR
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.64}
