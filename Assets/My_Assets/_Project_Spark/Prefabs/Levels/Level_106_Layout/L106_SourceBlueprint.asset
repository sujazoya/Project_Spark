  objectives:
  - Id: 1
    Title: Install 106 components
    Criterion: Authoritative project gameplay manager
  - Id: 2
    Title: Route 140 nets and 42 vias
    Criterion: Authoritative project gameplay manager
  - Id: 3
    Title: Commission CPU power and DDR4
    Criterion: Authoritative project gameplay manager
  - Id: 4
    Title: Complete POST and first boot
    Criterion: Authoritative project gameplay manager
  - Id: 5
    Title: Recover three boot failures
    Criterion: Authoritative project gameplay manager
  - Id: 6
    Title: Restore W141 and recertify system
    Criterion: Authoritative project gameplay manager
  faults:
  - Id: F1_CPU_PGOOD_TIMING
    Title: CPU Power-Good Timing
    Mechanism: CPU reset released before stabilized power
    Evidence: 
    Repair: Replace faulted resistor; repeat startup timing
  - Id: F2_SPI_FLASH_CONTACT
    Title: SPI Flash Contact
    Mechanism: Invalid SPI firmware reads
    Evidence: 
    Repair: Remove solder bridge or restore pad; verify firmware
  - Id: F3_eMMC_CONTACT
    Title: eMMC Storage Contact
    Mechanism: Boot storage inaccessible
    Evidence: 
    Repair: Repair storage connection; verify image and repeat boot
  safety:
    JumperId: W141
    LogicalSource: L106_SystemBootMonitor_U14.TRUSTED_SYSTEM_READY_OUT
    LogicalDestination: L106_IndependentSafety_U15.TRUSTED_SYSTEM_READY_IN
    PhysicalPinStatus: UNASSIGNED
    NetlistStatus: SCHEMATIC_REQUIRED
    StartsDisconnected: 1
