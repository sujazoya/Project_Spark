  levelId: level_39
  levelTitle: Across the Isolation Gap
  initialPage: 0
  pages:
  - title: 01 / Wire the isolated circuits
    explanation: "W01 TX_POS \u2192 SEND_IN. W02 SEND_OUT \u2192 TX_R_IN. W03 TX_R_OUT
      \u2192 OPTO_A. W04 OPTO_K \u2192 TX_RETURN. W05 RX_POS \u2192 PULLUP_IN. W06
      PULLUP_OUT \u2192 OPTO_C. W07 OPTO_E \u2192 RX_RETURN. Leave the returns separate."
    caption: "SEPARATE 5 V SUPPLIES  \u2022  SEPARATE RETURNS"
    parts:
    - id: tx-supply
      kind: 9
      position: {x: 0.1, y: 0.78}
      label: TX +5 V
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: send
      kind: 9
      position: {x: 0.27, y: 0.78}
      label: SEND
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: limit
      kind: 1
      position: {x: 0.43, y: 0.78}
      label: "470 \u03A9"
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: emitter
      kind: 9
      position: {x: 0.33, y: 0.48}
      label: TX OFF
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: gap
      kind: 9
      position: {x: 0.5, y: 0.48}
      label: LIGHT ONLY
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: receiver
      kind: 9
      position: {x: 0.67, y: 0.48}
      label: RX HIGH
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: pull-up
      kind: 1
      position: {x: 0.73, y: 0.78}
      label: "1 k\u03A9"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: rx-supply
      kind: 9
      position: {x: 0.9, y: 0.78}
      label: RX +5 V
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: tx-return
      kind: 9
      position: {x: 0.16, y: 0.27}
      label: TX RETURN
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    - id: rx-return
      kind: 9
      position: {x: 0.84, y: 0.27}
      label: RX RETURN
      color: {r: 0.65, g: 0.53, b: 0.99, a: 1}
