  m_Name: Level_94
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.Gameplay.SparkLevelDefinition
  levelId: level_94
  displayName: The Board Foundry
  description: Build and qualify a two-layer PCB, repair three faults, and recover
    the removable W035 jumper.
  completionMode: 0
  requiredTargetCount: 6
  requireClosedReturn: 0
  rejectShortCircuit: 1
  rejectTargetShort: 1
  allowIntermediateConnections: 1
  requireMinimumVoltage: 0
  minimumVoltage: 1
  allowAnyConfiguredPowerSource: 1
  powerSources:
  - sourceName: CONTROL_POWER
    positiveTerminalId: SUPPLY_POS
    negativeTerminalId: SUPPLY_RET
    nominalVoltage: 5
  targets:
  - targetId: level94_pcb_1
    displayName: Inspect the PCB schematic and nets
    description: Review the 34 route entries in the board netlist before fitting the first part.
    targetType: 2
    targetTerminalId: 
    requiredPositiveTerminalId: 
    requiredNegativeTerminalId: 
    targetComponentId: L94_Inspect
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 5.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level94_pcb_2
    displayName: Install all 27 components
    description: Choose each matching component, align its pin-1 mark, fit it, and solder the footprint contacts.
    targetType: 2
    targetTerminalId: 
    requiredPositiveTerminalId: 
    requiredNegativeTerminalId: 
    targetComponentId: L94_Assembly
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 5.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level94_pcb_3
    displayName: Route 34 copper tasks and plate six vias
    description: Connect W001 through W034 between the indicated native pads and plate V01 through V06 on the two-layer board.
    targetType: 2
    targetTerminalId: 
    requiredPositiveTerminalId: 
    requiredNegativeTerminalId: 
    targetComponentId: L94_Copper
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 5.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level94_pcb_4
    displayName: Commission the protected board
    description: Fit W035, enable the protected virtual bench, record live 3.3 V and feedback, and qualify a fresh load-current sample.
    targetType: 2
    targetTerminalId: 
    requiredPositiveTerminalId: 
    requiredNegativeTerminalId: 
    targetComponentId: L94_Commission
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 5.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level94_pcb_5
    displayName: Repair all three faults and retest
    description: Diagnose the open V05, incorrect R2 value and Q1 bridge. Isolate power for each repair and verify a fresh run.
    targetType: 2
    targetTerminalId: 
    requiredPositiveTerminalId: 
    requiredNegativeTerminalId: 
    targetComponentId: L94_Repair
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 5.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level94_pcb_6
    displayName: Recover W035 feedback and requalify
    description: Interrupt W035 with power on, confirm that the load is inhibited, restore feedback, reset the latch, and qualify again.
    targetType: 2
    targetTerminalId: 
    requiredPositiveTerminalId: 
    requiredNegativeTerminalId: 
    targetComponentId: L94_Recovery
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
