  levelTitle: Optical Quality Sorter
  initialPage: 0
  pages:
  - title: 01 / Sensor and motor branches
    explanation: "MAIN powers the conveyor motor and the light-sensing branch. The
      sensor branch puts the LDR above the 10 k\u03A9 resistor. The SENSE reading
      is taken at the junction between them, relative to supply negative."
    caption: "5 V SUPPLY \u2022 MAIN \u2022 TWO PARALLEL BRANCHES"
    parts:
    - id: source
      kind: 0
      position: {x: 0.1, y: 0.49}
      label: 5 V
      color: {r: 0.97, g: 0.29, b: 0.35, a: 1}
    - id: main
      kind: 5
      position: {x: 0.32, y: 0.75}
      label: MAIN
      color: {r: 0.97, g: 0.29, b: 0.35, a: 1}
    - id: ldr
      kind: 1
      position: {x: 0.57, y: 0.75}
      label: LDR
      color: {r: 0.2, g: 0.9, b: 0.78, a: 1}
    - id: divider
      kind: 1
      position: {x: 0.82, y: 0.75}
      label: "10 k\u03A9"
      color: {r: 0.98, g: 0.72, b: 0.32, a: 1}
    - id: motor
      kind: 9
      position: {x: 0.63, y: 0.43}
      label: MOTOR
      color: {r: 0.98, g: 0.72, b: 0.32, a: 1}
    - id: ground
      kind: 6
      position: {x: 0.72, y: 0.18}
      label: GND
      color: {r: 0.23, g: 0.66, b: 1, a: 1}
