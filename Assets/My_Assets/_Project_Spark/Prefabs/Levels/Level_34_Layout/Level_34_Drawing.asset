  m_Name: Level_34_Drawing
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.UI.VisualTeaching.SparkLevelDrawingAsset
  levelId: level_34
  levelTitle: Priority Power - Automatic Load Shedding
  initialPage: 0
  pages:
  - title: 01 / Feed the shared bus
    explanation: "W01 Battery_positive \u2192 FEED_IN. W02 FEED_OUT \u2192 Pump_A.
      W03 FEED_OUT \u2192 AUX_IN. W04 FEED_OUT \u2192 DEMAND_IN. FEED OUT is BUS.
      Each load draws through the same feeder, so increasing total current makes
      the bus voltage fall."
    caption: "5 V \u2192 10 \u03A9 FEEDER \u2192 THREE BRANCHES"
    parts:
    - id: supply
      kind: 9
      position: {x: 0.09, y: 0.55}
      label: BATTERY +
      color: {r: 0.98, g: 0.34, b: 0.4, a: 1}
    - id: feed
      kind: 1
      position: {x: 0.29, y: 0.55}
      label: "FEEDER 10 \u03A9"
      color: {r: 0.99, g: 0.71, b: 0.28, a: 1}
    - id: bus
      kind: 9
      position: {x: 0.49, y: 0.55}
      label: BUS
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: pump
      kind: 9
      position: {x: 0.81, y: 0.81}
      label: PUMP A
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: aux
      kind: 9
      position: {x: 0.81, y: 0.55}
      label: AUX IN
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: demand
      kind: 9
      position: {x: 0.81, y: 0.29}
      label: DEMAND IN
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    wires:
    - points:
      - {x: 0.09, y: 0.55}
      - {x: 0.245, y: 0.55}
      energized: 0
      color: {r: 0.98, g: 0.34, b: 0.4, a: 1}
    - points:
      - {x: 0.335, y: 0.55}
      - {x: 0.81, y: 0.55}
      energized: 0
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - points:
      - {x: 0.49, y: 0.55}
      - {x: 0.49, y: 0.81}
      - {x: 0.81, y: 0.81}
      energized: 0
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - points:
      - {x: 0.49, y: 0.55}
      - {x: 0.49, y: 0.29}
      - {x: 0.81, y: 0.29}
      energized: 0
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
  - title: 02 / Wire the loads and returns
    explanation: "W05 AUX_OUT \u2192 Fan_A. W06 DEMAND_OUT \u2192 R_DEMAND_IN. W07
      Pump_B \u2192 Battery_negative. W08 Fan_B \u2192 Battery_negative. W09 R_DEMAND_OUT
      \u2192 Battery_negative. The pump stays on BUS while the cutoff opens only
      the fan branch."
    caption: "PUMP DIRECT \u2022 FAN AND DEMAND SWITCHED"
    parts:
    - id: bus
      kind: 9
      position: {x: 0.11, y: 0.51}
      label: BUS
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: pump
      kind: 7
      position: {x: 0.65, y: 0.8}
      label: "PUMP 47 \u03A9"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: aux
      kind: 5
      position: {x: 0.35, y: 0.51}
      label: AUX CUTOFF
      color: {r: 0.99, g: 0.71, b: 0.28, a: 1}
    - id: fan
      kind: 7
      position: {x: 0.65, y: 0.51}
      label: "FAN 47 \u03A9"
      color: {r: 0.99, g: 0.71, b: 0.28, a: 1}
    - id: demand
      kind: 5
      position: {x: 0.35, y: 0.23}
      label: DEMAND
      color: {r: 0.99, g: 0.71, b: 0.28, a: 1}
    - id: bank
      kind: 1
      position: {x: 0.65, y: 0.23}
      label: "BANK 47 \u03A9"
      color: {r: 0.99, g: 0.71, b: 0.28, a: 1}
    - id: return
      kind: 9
      position: {x: 0.92, y: 0.51}
