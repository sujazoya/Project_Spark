%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7dbcf2efd0d400c45bb9124777514e60, type: 3}
  m_Name: Level_48_Drawing
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.UI.VisualTeaching.SparkLevelDrawingAsset
  levelId: level_48
  levelTitle: Hit the Mark
  initialPage: 0
  pages:
  - title: 01 / Wire the registration line
    explanation: Wire the 5 V and return branches, encoder A/B, MARK IN, driver PWM
      and motor, and PRINT TRIG. The two supply sockets each accept three wires.
    caption: "13 WIRES  \u2022  22 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.49}
      label: 5 V / RETURN
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.5, y: 0.49}
      label: CONTROL / DRIVER
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.49}
      label: EYE / ENCODER
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.49}
      - {x: 0.43, y: 0.49}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.49}
      - {x: 0.75, y: 0.49}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 02 / Calibrate the optical eye
    explanation: CALIBRATE crawls the web at 18 RPM. The eye observes two genuine
      marks. Their measured distance sets the mark pitch.
    caption: "TWO GENUINE MARKS  \u2022  160 COUNTS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.49}
      label: MARK 1
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.5, y: 0.49}
      label: 160 COUNTS
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.49}
      label: MARK 2
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.49}
      - {x: 0.43, y: 0.49}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.49}
      - {x: 0.75, y: 0.49}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 03 / Predict the print position
    explanation: Verify three prints at 30 RPM, then select 60 RPM while moving.
      The controller uses encoder distance and allows for the powered head stroke.
    caption: "80 COUNTS  \u2022  \xB12 MM"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.49}
      label: OPTICAL EYE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.5, y: 0.49}
      label: 80 COUNTS
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.49}
      label: PRINT HEAD
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.49}
      - {x: 0.43, y: 0.49}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.49}
      - {x: 0.75, y: 0.49}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 04 / Prove safe recovery
    explanation: Run GLARE TEST and verify a genuine print. Cover the eye with MISSING
      MARK and wait for safe stop. Restore the eye, RESET FAULT, then START and verify
      a recovered print.
    caption: "GLARE  \u2022  MISSING MARK  \u2022  RESET"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.49}
      label: REJECT GLARE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.5, y: 0.49}
      label: SAFE STOP
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.49}
      label: RESET / START
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.49}
      - {x: 0.43, y: 0.49}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.49}
      - {x: 0.75, y: 0.49}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
