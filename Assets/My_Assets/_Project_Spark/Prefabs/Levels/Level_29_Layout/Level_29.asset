    targetTerminalId: ''
    requiredPositiveTerminalId: ''
    requiredNegativeTerminalId: ''
    targetComponentId: 'L29_Charged'
    minimumVoltage: 0
    minimumCurrent: 0.002
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 1
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: 'level29_auto_2'
    displayName: 'Automatic isolated transfer'
    description: 'MAIN is open; backup diode powers LED while main/charge/source current stays below 0.10 mA.'
