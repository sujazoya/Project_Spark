  m_Name: Level_29
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.Gameplay.SparkLevelDefinition
  levelId: level_29
  displayName: 'Automatic Emergency Backup - No Manual Transfer'
  description: 'Build a three-diode automatic capacitor backup. Verify charging, isolate the mains with the main switch, sustain LED backup for 2 accepted simulated seconds, then restore power and recharge. SparkLevel29AutomaticBackup validates the sequence and publishes six runtime LED gate aliases. No SPDT is used. Without the observer the level cannot complete.'
  completionMode: 0
  requiredTargetCount: 6
  requireClosedReturn: 1
  rejectShortCircuit: 1
  rejectTargetShort: 1
  allowIntermediateConnections: 1
  requireMinimumVoltage: 0
  minimumVoltage: 4.8
  allowAnyConfiguredPowerSource: 1
  powerSources:
  - sourceName: PowerSupply_01
    positiveTerminalId: Battery_positive
    negativeTerminalId: Battery_negative
    nominalVoltage: 5
  targets:
  - targetId: 'level29_auto_0'
    displayName: 'Correct automatic-backup circuit'
    description: 'Required nets, values and healthy parts verified by the level observer.'
    targetType: 3
    targetTerminalId: ''
    requiredPositiveTerminalId: ''
    requiredNegativeTerminalId: ''
    targetComponentId: 'L29_Wiring'
    minimumVoltage: 0
    minimumCurrent: 0.002
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 1
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: 'level29_auto_1'
    displayName: 'Storage charged with observed rise'
    description: 'Capacitor rises at least 0.30 V and reaches 4.10 V.'
