      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 04 / Recover the trusted wrench
    explanation: Open W129 during loaded travel. Restore the wire, validate fresh
      contact force and reset. Complete a fresh full service run.
    caption: "W129  \u2022  PROTECTED HOLD"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: HOLD
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: RESET
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
