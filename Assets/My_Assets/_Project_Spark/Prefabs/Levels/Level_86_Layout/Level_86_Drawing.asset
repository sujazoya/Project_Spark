  levelId: level_86
  levelTitle: The Orbital Forge
  initialPage: 0
  pages:
  - title: 01 / Commission the service cell
    explanation: Wire the equipment, test the independent interlock, home every axis
      and calibrate the wrist and stereo reference.
    caption: "152 DIRECT WIRES  \u2022  7 AXES"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: WIRE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: HOME
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: TEST
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
