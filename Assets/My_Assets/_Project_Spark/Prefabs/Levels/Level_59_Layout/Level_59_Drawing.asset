      - {x: 0.75, y: 0.59}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 02 / Energize the dead bus
    explanation: Verify QG open. Enable BMS, precharge the DC link, then form the
      island and restore the essential feeders.
    caption: "BMS  \u2022  PRECHARGE  \u2022  50 HZ"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.59}
      label: QG OPEN
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.59, y: 0.59}
      label: PRECHARGE
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.59}
      label: ESSENTIALS
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.59}
      - {x: 0.43, y: 0.59}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
