      - {x: 0.75, y: 0.59}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 04 / Recover and certify
    explanation: Prove essential service after generator failure. Repair, reset,
      resynchronize and restore full load before certifying.
    caption: "ISOLATE  \u2022  SHED  \u2022  RESTORE"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.59}
      label: FAILURE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.59, y: 0.59}
