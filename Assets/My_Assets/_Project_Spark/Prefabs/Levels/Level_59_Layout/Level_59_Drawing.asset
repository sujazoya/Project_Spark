  levelId: level_59
  levelTitle: Bring Back the Power
  initialPage: 0
  pages:
  - title: 01 / Build the control network
    explanation: Wire control power, battery paths and the ordered A/B/C connections.
    caption: "42 WIRES  \u2022  66 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.59}
      label: 5 V CONTROL
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.59, y: 0.59}
      label: BATTERY
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.59}
      label: ABC BUS
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
