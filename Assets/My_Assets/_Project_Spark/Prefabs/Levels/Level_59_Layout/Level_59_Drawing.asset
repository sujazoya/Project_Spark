      - {x: 0.75, y: 0.59}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 03 / Synchronize and restore
    explanation: Start and synchronize the generator. Close QGEN within the relay
      window, then bring on motor and auxiliary loads.
    caption: "\u0394F \u2264 0.2 HZ  \u2022  \u0394PHASE \u2264 5\xB0"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.59}
      label: START
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.59, y: 0.59}
      label: MATCH
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.59}
      label: RESTORE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.59}
      - {x: 0.43, y: 0.59}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
