  levelId: level_68
  levelTitle: Tame the Heat
  initialPage: 0
  pages:
  - title: 01 / Wire the thermal network
    explanation: Route heater and pump drive permissions, RTDs, valves and safety.
      Install W78 last.
    caption: "78 WIRES  \u2022  122 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.68}
      label: POWER
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.68, y: 0.68}
      label: SENSORS
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.68}
      label: SAFETY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.68}
      - {x: 0.43, y: 0.68}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.68, y: 0.68}
      - {x: 0.75, y: 0.68}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 02 / Commission and tune
    explanation: Calibrate temperature, flow and pressure. Start the three pumps,
      enable heat and tune the two cascade loops.
    caption: "65\xB0C PRODUCT  \u2022  3 LOOPS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.68}
      label: CALIBRATE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.68, y: 0.68}
      label: CIRCULATE
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.68}
      label: TUNE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.68}
      - {x: 0.43, y: 0.68}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.68, y: 0.68}
      - {x: 0.75, y: 0.68}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 03 / Recover waste heat
    explanation: Compare stable heating duty before and after closing the regenerative
      bypass. Test inlet temperature, surge and fouling.
    caption: "PREHEAT  \u2022  UTILITY  \u2022  BYPASS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.68}
      label: BASELINE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.68, y: 0.68}
      label: RECOVER
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.68}
      label: VERIFY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.68}
      - {x: 0.43, y: 0.68}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
