      - {x: 0.75, y: 0.68}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 04 / Restore the outlet RTD
    explanation: Remove W78 and verify heater isolation. Reconnect, calibrate, reset,
      recommission and repeat a disturbance before certification.
    caption: "W78  \u2022  INVALID  \u2022  SAFE"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.68}
      label: ISOLATE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.68, y: 0.68}
      label: RECONNECT
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.68}
      label: CERTIFY
