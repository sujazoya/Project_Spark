  objectives:
  - Id: 01
    Title: Assembly
    Criterion: 62 parts placed correctly and soldered
  - Id: 02
    Title: CopperConnectivity
    Criterion: 82 routes and 18 vias validated against reconciled pin-level netlist
  - Id: 03
    Title: FirstBoot
    Criterion: 3.3V,8MHz crystal,48MHz PLL,reset,firmware programming and qualified
      boot
  - Id: 04
    Title: Diagnostics
    Criterion: GPIO,timers,SPI,I2C,watchdog self-test successful
  - Id: 05
    Title: FaultRecovery
    Criterion: Crystal startup, SPI open via, reset resistor faults repaired; fresh
      new boot
  - Id: 06
    Title: W083
    Criterion: Removable heartbeat path disconnected,inhibit,replace,fresh pulses,explicit
      reset,new boot and test
  faults:
  - Id: F01
    Title: Oscillator capacitor fault
    Mechanism: Y1/C1 | 8 MHz crystal unstable or missing
    Evidence: Verified pin-level topology; Authorized physical repair; Fresh boot/diagnostic
      proof
    Repair: Replace faulty oscillator capacitor
  - Id: F02
    Title: SPI flash trace via open
    Mechanism: V11/SPI_DATA | Internal firmware runs, external 8MB SPI flash fails
    Evidence: Verified pin-level topology; Authorized physical repair; Fresh boot/diagnostic
      proof
    Repair: Restore open via and test bus
  - Id: F03
    Title: Defective reset pull-up resistor
    Mechanism: R_RESET | Reset stuck low or noisy, boot blocked
    Evidence: Verified pin-level topology; Authorized physical repair; Fresh boot/diagnostic
      proof
    Repair: Replace resistor and verify reset release
  safety:
    JumperId: W083
    LogicalSource: U1.APPLICATION_HEARTBEAT_OUT
    LogicalDestination: U8.TRUSTED_HEARTBEAT_IN
    PhysicalPinStatus: SCHEMATIC_REQUIRED
    NetlistStatus: SCHEMATIC_REQUIRED
    StartsDisconnected: 1
