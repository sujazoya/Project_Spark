  - title: "02 / Wire the UP path"
    explanation: "W01 Battery_positive → UP_Feed_IN. W07 UP_Feed_OUT → Upper_Limit_IN. W09 Upper_Limit_OUT → Motor_A. W12 Motor_B → UP_Return_IN. W04 Battery_negative → UP_Return_OUT. Both UP contacts close in UP. The upper limit opens when the carriage reaches the top."
    caption: "A POSITIVE TO B • UPPER LIMIT STOPS UP"
    parts:
    - id: positive
      kind: 9
      position: {x: 0.08, y: 0.62}
      label: "BATTERY +"
      color: {r: 0.98, g: 0.34, b: 0.4, a: 1}
    - id: feed
      kind: 5
      position: {x: 0.23, y: 0.62}
      label: "UP FEED"
      color: {r: 0.31, g: 0.88, b: 0.84, a: 1}
    - id: limit
      kind: 5
      position: {x: 0.4, y: 0.62}
      label: "UPPER LIMIT"
      color: {r: 0.31, g: 0.88, b: 0.84, a: 1}
    - id: motor
      kind: 7
      position: {x: 0.56, y: 0.62}
      label: "MOTOR A → B"
      color: {r: 1, g: 0.77, b: 0.34, a: 1}
    - id: return
      kind: 5
      position: {x: 0.73, y: 0.62}
      label: "UP RETURN"
      color: {r: 0.31, g: 0.88, b: 0.84, a: 1}
    - id: negative
      kind: 9
      position: {x: 0.92, y: 0.62}
      label: "BATTERY −"
      color: {r: 0.27, g: 0.68, b: 1, a: 1}
    wires:
