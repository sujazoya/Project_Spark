  levelId: level_30
  levelTitle: "Elevate the Lamp — Motor Control and Limit Switches"
  initialPage: 0
  pages:
  - title: "01 / What the lift must do"
    explanation: "The UP/OFF/DOWN selector controls two feed-and-return pairs. UP makes Motor A positive relative to B. DOWN reverses that polarity. Each limit opens only its own direction, so the lift can leave either end. The top contact switches the lamp on its own branch."
    caption: "UP RAISES • TOP STOPS AND LIGHTS • DOWN LOWERS"
    parts:
    - id: bottom
      kind: 9
      position: {x: 0.17, y: 0.73}
      label: "BOTTOM"
      color: {r: 0.31, g: 0.88, b: 0.84, a: 1}
    - id: top
      kind: 9
      position: {x: 0.5, y: 0.73}
      label: "TOP / LAMP ON"
      color: {r: 0.36, g: 0.91, b: 0.54, a: 1}
    - id: return
      kind: 9
      position: {x: 0.83, y: 0.73}
      label: "BOTTOM AGAIN"
      color: {r: 0.31, g: 0.88, b: 0.84, a: 1}
    - id: down_blocked
      kind: 9
      position: {x: 0.17, y: 0.28}
      label: "DOWN BLOCKED"
      color: {r: 0.51, g: 0.62, b: 0.72, a: 1}
    - id: up_blocked
      kind: 9
      position: {x: 0.5, y: 0.28}
      label: "UP BLOCKED"
      color: {r: 0.51, g: 0.62, b: 0.72, a: 1}
    - id: lamp_off
      kind: 9
      position: {x: 0.83, y: 0.28}
      label: "LAMP OFF"
      color: {r: 0.51, g: 0.62, b: 0.72, a: 1}
