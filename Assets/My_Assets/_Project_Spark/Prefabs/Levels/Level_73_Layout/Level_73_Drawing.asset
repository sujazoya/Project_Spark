      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 02 / Establish controlled contact
    explanation: Calibrate, condition the pad, spin both drives, clamp a wafer and
      enable the zone controller.
    caption: "SPEED  \u2022  DOWNFORCE  \u2022  SLURRY"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: COMMISSION
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: CLAMP
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: ENGAGE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
