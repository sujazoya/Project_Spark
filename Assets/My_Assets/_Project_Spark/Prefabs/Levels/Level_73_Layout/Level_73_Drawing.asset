      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 04 / Restore downforce
    explanation: Disconnect W98 during contact. Reconnect, calibrate and verify the
      unloaded sensor. Then certify a fresh wafer.
    caption: "W98  \u2022  CARRIER RETRACTION"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: RETRACT
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
