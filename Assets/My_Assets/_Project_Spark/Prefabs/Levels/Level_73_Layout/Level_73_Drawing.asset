  levelId: level_73
  levelTitle: Polish to Perfection
  initialPage: 0
  pages:
  - title: 01 / Wire the CMP workbench
    explanation: Connect drives, force, slurry, cleaning and measurement. Install
      downforce feedback W98 last.
    caption: "98 WIRES  \u2022  152 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: POWER
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: PROCESS
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: SAFETY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
