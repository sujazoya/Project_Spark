      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 03 / Planarize and verify
    explanation: Verify endpoint, rinse, brush and dry before checking wafer flatness,
      removal uniformity and defects.
    caption: "ENDPOINT  \u2022  RINSE  \u2022  METROLOGY"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: POLISH
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: CLEAN
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: SCAN
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
