  m_Script: {fileID: 11500000, guid: 1581588b391302d4d80156907e5be0fb, type: 3}
  m_Name: Level_27
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.Gameplay.SparkLevelDefinition
  levelId: level_27
  displayName: Charge the Reservoir - Capacitor Smoothing
  description: Build a 5 V DC diode-isolated reservoir circuit. A 220 ohm charging
    resistor feeds a 1000 uF capacitor and a 330 ohm LED load branch. Observe capacitor
    charging and confirm the stable output. This level demonstrates DC energy storage,
    not AC ripple suppression.
  completionMode: 0
  requiredTargetCount: 6
  requireClosedReturn: 1
  rejectShortCircuit: 1
  rejectTargetShort: 1
  allowIntermediateConnections: 1
  requireMinimumVoltage: 0
  minimumVoltage: 1
  allowAnyConfiguredPowerSource: 1
  powerSources:
  - sourceName: PowerSupply_01
    positiveTerminalId: Battery_positive
    negativeTerminalId: Battery_negative
    nominalVoltage: 5
  targets:
  - targetId: level27_supply
    displayName: Stable 5 V Supply
    description: Confirm the 5 V DC source.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: Battery_positive
    requiredNegativeTerminalId: Battery_negative
    targetComponentId: PowerSupply_01
    minimumVoltage: 4.8
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 5.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level27_diode_forward
    displayName: Protection Diode Forward
    description: Confirm the diode is forward biased.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: D_ISOLATE_Anode
    requiredNegativeTerminalId: D_ISOLATE_Cathode
    targetComponentId: D_ISOLATE_Component
    minimumVoltage: 0.45
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 1
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level27_cap_charge
    displayName: Capacitor Charged
    description: Confirm reservoir capacitor voltage reaches 3.1 to 3.7 V in this
      loaded DC circuit.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: C_RESERVOIR_Positive
    requiredNegativeTerminalId: C_RESERVOIR_Negative
    targetComponentId: C_RESERVOIR_Component
    minimumVoltage: 3.1
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 3.7
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level27_led_on
    displayName: Indicator LED ON
    description: Confirm the indicator LED glows when the capacitor rail supplies
      the load.
    targetType: 3
    targetTerminalId: 
    requiredPositiveTerminalId: LED_Anode
    requiredNegativeTerminalId: LED_Cathode
    targetComponentId: led
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level27_safe_current
    displayName: Safe LED Branch Current
    description: Verify approximately 3-6 mA through the 330 ohm LED resistor.
    targetType: 6
    targetTerminalId: 
    requiredPositiveTerminalId: R_LED_Input
    requiredNegativeTerminalId: R_LED_Output
    targetComponentId: R_LED_Component
    minimumVoltage: 0
    minimumCurrent: 0.003
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 1
    maximumCurrent: 0.006
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level27_charge_resistor
    displayName: Charging Resistor Voltage
    description: Check approximately 0.7-1.2 V drop across the 220 ohm charging resistor
      after settling.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: R_CHARGE_Input
    requiredNegativeTerminalId: R_CHARGE_Output
    targetComponentId: R_CHARGE_Component
    minimumVoltage: 0.7
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 1.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  failureMode: 0
  requiredHealthyResistorIds: []
  requireHealthyInstalledResistors: 1
  successOutputIds: []
  failureOutputIds: []
  unlockNextLevelOnCompletion: 1
