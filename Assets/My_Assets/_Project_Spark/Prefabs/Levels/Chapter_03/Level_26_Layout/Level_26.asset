    description: Verify a drop of 1.3 to 1.9 V across the 220 ohm resistor.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: R_LIMIT_Input
    requiredNegativeTerminalId: R_LIMIT_Output
    targetComponentId: R_LIMIT_Component
    minimumVoltage: 1.3
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 1.9
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  failureMode: 0
