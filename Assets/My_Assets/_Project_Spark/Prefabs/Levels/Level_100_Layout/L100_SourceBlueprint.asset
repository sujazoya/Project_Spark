  objectives:
  - Id: 01
    Title: Assemble 70 components
    Criterion: Requires live verified netlist/measurement/firmware/safety evidence
  - Id: 02
    Title: Route 92 copper tasks and 20 vias
    Criterion: Requires live verified netlist/measurement/firmware/safety evidence
  - Id: 03
    Title: Commission I2C and SPI
    Criterion: Requires live verified netlist/measurement/firmware/safety evidence
  - Id: 04
    Title: Qualify UART and Multi-Bus Diagnostics
    Criterion: Requires live verified netlist/measurement/firmware/safety evidence
  - Id: 05
    Title: Recover three communication faults
    Criterion: Requires live verified netlist/measurement/firmware/safety evidence
  - Id: 06
    Title: W093 disconnection and fresh recovery
    Criterion: Requires live verified netlist/measurement/firmware/safety evidence
  faults:
  - Id: F01
    Title: I2C pullup resistor
    Mechanism: Rise-time violation / possible invalid logic levels
    Evidence: Approved physical netlist; Authorized repair/firmware mutation; Fresh
      I2C/SPI/UART evidence
    Repair: Replace incorrect resistor, verify electrical response
  - Id: F02
    Title: SPI SCK plated via
    Mechanism: SCK not received by target peripheral
    Evidence: Approved physical netlist; Authorized repair/firmware mutation; Fresh
      I2C/SPI/UART evidence
    Repair: Restore via connectivity, retest transactions
  - Id: F03
    Title: UART configuration
    Mechanism: Baud and frame mismatch
    Evidence: Approved physical netlist; Authorized repair/firmware mutation; Fresh
      I2C/SPI/UART evidence
    Repair: Correct endpoint firmware setting, verify decoded bytes
  safety:
    JumperId: W093
    LogicalSource: L100_MCU_U1.TRUSTED_COMM_HEALTH_OUT
    LogicalDestination: L100_CommSafetySupervisor_U9.TRUSTED_COMM_HEALTH_IN
    PhysicalPinStatus: SCHEMATIC_REQUIRED
    NetlistStatus: SCHEMATIC_REQUIRED
    StartsDisconnected: 1
