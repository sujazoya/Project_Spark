      - {x: 0.75, y: 0.63}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 02 / Commission the reserve
    explanation: Calibrate sensors, tune the response and charge the rotor before
      enabling disturbances.
    caption: "KINETIC ENERGY  \u2022  VIRTUAL INERTIA"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.63}
      label: CALIBRATE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.63, y: 0.63}
      label: ACCELERATE
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.63}
      label: RESERVE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.63}
      - {x: 0.43, y: 0.63}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
