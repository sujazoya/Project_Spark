      - {x: 0.75, y: 0.63}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 04 / Repair and certify
    explanation: Open the encoder link. Reconnect, reset, recalibrate and repeat
      an inertia response test.
    caption: "W58  \u2022  SPEED ENCODER"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.63}
      label: ISOLATE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.63, y: 0.63}
      label: REPAIR
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
