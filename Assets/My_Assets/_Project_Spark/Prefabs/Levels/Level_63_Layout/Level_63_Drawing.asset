  levelId: level_63
  levelTitle: Catch the Frequency
  initialPage: 0
  pages:
  - title: 01 / Build the inertia lab
    explanation: Wire the sources, battery, bidirectional converter and frequency
      feedback. Install W58 last.
    caption: "58 WIRES  \u2022  90 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.63}
      label: GRID
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.63, y: 0.63}
      label: STORAGE
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.63}
      label: FEEDBACK
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.63}
      - {x: 0.43, y: 0.63}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
