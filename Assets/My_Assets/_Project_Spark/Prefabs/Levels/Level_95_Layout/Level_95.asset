    maximumVoltage: 5.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level95_pcb_3
    displayName: Capture and qualify the three clocks
    description: Capture the powered master and divided clocks near 1024 Hz, 256 Hz and 2 Hz.
