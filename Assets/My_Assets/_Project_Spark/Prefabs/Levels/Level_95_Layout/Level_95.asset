    useMaximumPower: 0
    maximumPower: 0
  - targetId: level95_pcb_2
    displayName: Route 48 traces, plate 10 vias and fit W049
    description: Route the 48 specified traces through the original pads and ten vias. Install W049 as the separate 36th part.
