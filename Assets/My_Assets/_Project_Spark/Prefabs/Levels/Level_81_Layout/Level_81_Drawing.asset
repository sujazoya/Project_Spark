      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 04 / Restore ECC supervision
    explanation: Disconnect W094 during a live mission. Reconnect, diagnose, revalidate,
      explicitly reset and fly a fresh mission.
    caption: "W094  \u2022  MISSION SAFE HOLD"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: HOLD
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: CHECK
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: CERTIFY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
