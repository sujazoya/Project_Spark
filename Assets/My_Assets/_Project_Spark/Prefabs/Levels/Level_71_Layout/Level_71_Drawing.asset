  m_Script: {fileID: 11500000, guid: 7dbcf2efd0d400c45bb9124777514e60, type: 3}
  m_Name: Level_71_Drawing
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.UI.VisualTeaching.SparkLevelDrawingAsset
  levelId: level_71
  levelTitle: Etch the Future
  initialPage: 0
  pages:
  - title: 01 / Wire the plasma workbench
    explanation: Route control power, vacuum, gas, matching, wafer, optics and safety.
      Install W90 last.
    caption: "90 WIRES  \u2022  140 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: POWER
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: PROCESS I/O
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: SAFETY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.71, y: 0.71}
      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 02 / Commission the reactor
    explanation: Calibrate the sensors, pump down, load and clamp a wafer, then establish
      flow and tune the RF network.
    caption: "VACUUM  \u2022  GAS FLOW  \u2022  RF"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: VACUUM
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: MATCH
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: IGNITE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.71, y: 0.71}
      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 03 / Etch and inspect
    explanation: Enable endpoint control, etch until the spectrum changes, inspect
      the wafer and recover the three disturbances.
    caption: "OPTICAL ENDPOINT  \u2022  METROLOGY"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: ETCH
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: INSPECT
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: RECOVER
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.71, y: 0.71}
      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 04 / Restore optical feedback
    explanation: With etch active, remove W90. Restore the wire, recalibrate, reset,
      and certify a fresh wafer.
    caption: "W90  \u2022  RF ISOLATION  \u2022  RECERTIFY"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: ISOLATE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: RECONNECT
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: CERTIFY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
