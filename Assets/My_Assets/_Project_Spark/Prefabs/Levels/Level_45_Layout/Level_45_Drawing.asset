  levelId: level_45
  levelTitle: Hold the Speed
  initialPage: 0
  pages:
  - title: 01 / Build the speed loop
    explanation: Connect controller and driver power, encoder A/B, controller PWM
      to driver PWM, and both motor leads. Add encoder B (W06) last so it can be
      removed with Undo Last.
    caption: "5 V  \u2022  ENCODER A/B  \u2022  PWM  \u2022  MOTOR"
    parts:
    - id: source
      kind: 9
      position: {x: 0.12, y: 0.8}
      label: 5 V + RETURN
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    - id: encoder
      kind: 9
      position: {x: 0.14, y: 0.48}
      label: ENCODER
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: decoder
      kind: 9
      position: {x: 0.82, y: 0.48}
      label: GOVERNOR
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: phaseA
      kind: 9
      position: {x: 0.47, y: 0.64}
      label: ENCODER A/B
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: phaseB
      kind: 9
      position: {x: 0.47, y: 0.3}
      label: PWM COMMAND
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    - id: index
      kind: 9
      position: {x: 0.47, y: 0.48}
      label: MOTOR / BRAKE
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
