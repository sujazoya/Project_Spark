    - points:
      - {x: 0.12, y: 0.8}
      - {x: 0.82, y: 0.8}
      - {x: 0.82, y: 0.57}
      energized: 0
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    - points:
