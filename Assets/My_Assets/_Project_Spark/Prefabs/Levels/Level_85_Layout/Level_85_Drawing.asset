      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 03 / Capture and verify the dock
    explanation: Wait for compliant capture and verify all six independent latch
      travels, the electrical coupler and the pressure seal.
    caption: "CONTACT  \u2022  6 LATCHES  \u2022  SEAL"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: CAPTURE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: LATCH
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: VERIFY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
