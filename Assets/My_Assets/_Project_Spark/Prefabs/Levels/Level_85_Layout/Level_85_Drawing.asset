  levelId: level_85
  levelTitle: The Last Meter
  initialPage: 0
  pages:
  - title: 01 / Assemble rendezvous controls
    explanation: Use the direct Wire tool. Match terminal identities and keep the
      W123 cable accessible.
    caption: 146 EQUIPMENT WIRES
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: WIRE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: POWER
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: TEST
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.71, y: 0.71}
      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 02 / Fly the approach corridor
    explanation: Calibrate the navigation sensors and test a finite RCS pulse. Stop
      at the three holds before the final docking segment.
    caption: "100 M  \u2022  30 M  \u2022  5 M"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: CALIBRATE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: APPROACH
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: HOLD
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
      - {x: 0.43, y: 0.71}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
