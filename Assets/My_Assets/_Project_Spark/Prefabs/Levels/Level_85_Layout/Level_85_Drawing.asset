      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 04 / Repair the closing-rate channel
    explanation: Open W123 while closing. Watch controlled braking. Restore fresh
      readings, check safe, reset, return to staging and fly a new complete approach.
    caption: "W123  \u2022  FRESH RATE  \u2022  RESET"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: ABORT
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: RECONNECT
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: CERTIFY
