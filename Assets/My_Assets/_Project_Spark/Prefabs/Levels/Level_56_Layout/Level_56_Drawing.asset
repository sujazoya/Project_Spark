  levelId: level_56
  levelTitle: Harvest the Spin
  initialPage: 0
  pages:
  - title: 01 / Wire the recovery rig
    explanation: Connect the converter, storage protection, chopper and measurement
      channels. Install W16 last.
    caption: "30 WIRES  \u2022  48 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.56}
      label: SUPPLY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.56, y: 0.56}
      label: CONVERTER
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.56}
      label: BANK
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.56}
      - {x: 0.43, y: 0.56}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
