      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 03 / Optimize and reuse
    explanation: Repeat with a lower current. Compare supply work for matched runs
      from 20 RPM to 90 RPM.
    caption: "\u226560% RECOVERY"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.56}
      label: LOW CURRENT
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.56, y: 0.56}
      label: VERIFY
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.56}
      label: REUSE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
