      - {x: 0.75, y: 0.56}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 02 / Release kinetic energy
    explanation: Compare the flywheel energy change with the energy gained by the
      capacitor. Losses include winding heat, friction and converter heat.
    caption: "90 \u2192 20 RPM"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.56}
      label: FLYWHEEL
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.56, y: 0.56}
      label: GENERATOR
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.56}
      label: SUPERCAP
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
