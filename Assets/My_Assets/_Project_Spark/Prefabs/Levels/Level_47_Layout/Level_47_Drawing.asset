  levelTitle: Hold the Tension
  initialPage: 0
  pages:
  - title: 01 / Wire the winding loop
    explanation: Connect both drives and encoders. Connect W13 and W14 to sensor
      power. Connect W15 from Sensor Signal to Tension In last.
    caption: "15 WIRES  \u2022  TWO DRIVES  \u2022  ANALOG SENSOR"
    parts:
    - id: source
      kind: 9
      position: {x: 0.12, y: 0.8}
      label: 5 V + RETURN
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    - id: encoder
      kind: 9
      position: {x: 0.14, y: 0.48}
      label: DANCER SENSOR
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: decoder
      kind: 9
