  levelTitle: Hold the Line
  initialPage: 0
  pages:
  - title: 01 / Close the loop
    explanation: W01 SUPPLY_PLUS to DRIVER_PLUS. W02 SUPPLY_RET to DRIVER_RET. W03
      COMMAND_OUT to COMMAND_IN. W04 POSITION_OUT to POSITION_IN. W05 OUT_A to MOTOR_A.
      W06 OUT_B to MOTOR_B. Add the motor wires last.
    caption: "5 V SUPPLY  \u2022  REVERSIBLE H-BRIDGE"
    parts:
    - id: source
      kind: 9
      position: {x: 0.13, y: 0.8}
      label: 5 V / RET
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    - id: driver
      kind: 9
      position: {x: 0.47, y: 0.74}
