    - id: motor
      kind: 9
      position: {x: 0.84, y: 0.74}
      label: MOTOR
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: command
      kind: 9
      position: {x: 0.13, y: 0.37}
      label: COMMAND MANUAL
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
