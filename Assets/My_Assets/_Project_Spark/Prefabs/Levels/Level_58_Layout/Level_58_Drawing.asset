      - {x: 0.75, y: 0.58}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 04 / Repair and certify
    explanation: Prove Q0 backup. Restore Q2, reconnect W16 and repeat a selective
      test.
    caption: "Q2 FAILURE  \u2022  W16 LOSS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.58}
      label: BACKUP Q0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
