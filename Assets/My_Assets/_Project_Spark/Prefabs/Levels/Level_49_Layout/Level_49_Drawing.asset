  m_Script: {fileID: 11500000, guid: 7dbcf2efd0d400c45bb9124777514e60, type: 3}
  m_Name: Level_49_Drawing
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.UI.VisualTeaching.SparkLevelDrawingAsset
  levelId: level_49
  levelTitle: Cut on the Mark
  initialPage: 0
  pages:
  - title: 01 / Build the flying shear
    explanation: Connect power and return, registration feedback, carriage drive,
      cutter trigger, guard and home. Verify the full wire map.
    caption: "15 WIRES  \u2022  26 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.49}
      label: 5 V / RETURN
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.5, y: 0.49}
      label: CARRIAGE DRIVER
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.49}
      label: GUARD / HOME
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.49}
      - {x: 0.43, y: 0.49}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.49}
      - {x: 0.75, y: 0.49}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 02 / Home and calibrate
    explanation: Seek the home sensor, then measure two real marks while the web
      moves slowly.
    caption: "HOME  \u2022  TWO MARKS  \u2022  160 COUNTS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.49}
      label: HOME SENSOR
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.5, y: 0.49}
      label: 160 COUNTS
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.49}
      label: OPTICAL EYE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.49}
      - {x: 0.43, y: 0.49}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.49}
      - {x: 0.75, y: 0.49}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 03 / Match the web
    explanation: The carriage tracks the moving mark through the blade stroke. Check
      both the position error and the speed difference.
    caption: "30 / 60 RPM  \u2022  25 MM TRACKING"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.49}
      label: ACCELERATE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.5, y: 0.49}
      label: SYNC / CUT
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.49}
      label: RETURN
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.49}
      - {x: 0.43, y: 0.49}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.49}
      - {x: 0.75, y: 0.49}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 04 / Prove recovery
    explanation: Recover from a speed dip, then open the guard. Close it and explicitly
      reset, re-home and restart.
    caption: "SPEED TEST  \u2022  GUARD TEST"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.49}
      label: SPEED DIP
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.5, y: 0.49}
      label: GUARD TRIP
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.49}
      label: RESET / HOME
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.49}
      - {x: 0.43, y: 0.49}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
