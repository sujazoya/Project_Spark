      - {x: 0.765, y: 0.63}
      - {x: 0.92, y: 0.63}
      energized: 0
      color: {r: 0.27, g: 0.68, b: 1, a: 1}
  - title: "03 / Motor contact and STOP"
    explanation: "W10 RUN_OUT → Motor_A. W09 Motor_B → Battery_negative. MAIN OUT feeds RUN_IN through W03. When STOP is pressed, coil current falls and both relay contacts open. Release STOP. START is still open, so the conveyor stays stopped."
    caption: "COIL OFF → MOTOR CONTACT OPENS → MOTOR STOPS"
    parts:
    - id: main_out
      kind: 9
      position: {x: 0.1, y: 0.62}
      label: "MAIN OUT"
      color: {r: 0.98, g: 0.34, b: 0.4, a: 1}
    - id: run
      kind: 5
      position: {x: 0.34, y: 0.62}
      label: "MOTOR CONTACT"
      color: {r: 1, g: 0.77, b: 0.34, a: 1}
    - id: motor
      kind: 7
      position: {x: 0.6, y: 0.62}
      label: "MOTOR A → B"
      color: {r: 1, g: 0.77, b: 0.34, a: 1}
    - id: return
      kind: 9
      position: {x: 0.88, y: 0.62}
      label: "BATTERY −"
      color: {r: 0.27, g: 0.68, b: 1, a: 1}
    wires:
    - points:
      - {x: 0.1, y: 0.62}
      - {x: 0.295, y: 0.62}
      energized: 0
      color: {r: 0.98, g: 0.34, b: 0.4, a: 1}
    - points:
      - {x: 0.385, y: 0.62}
      - {x: 0.567, y: 0.62}
      energized: 0
      color: {r: 1, g: 0.77, b: 0.34, a: 1}
    - points:
      - {x: 0.633, y: 0.62}
      - {x: 0.88, y: 0.62}
      energized: 0
      color: {r: 0.27, g: 0.68, b: 1, a: 1}
  - title: "04 / Prove safe restoration"
    explanation: "1/6: MAIN ON, conveyor idle. 2/6: Press START and release it. The conveyor keeps running. 3/6: Press STOP and release it. The conveyor stays stopped. 4/6: START again, release it, then turn MAIN OFF. 5/6: Restore MAIN with both buttons released. The conveyor stays stopped. 6/6: Press and release START to restart deliberately."
    caption: "COMPLETE ALL SIX CHECKS IN ORDER"
    parts:
    - id: idle
      kind: 9
      position: {x: 0.17, y: 0.75}
      label: "1 MAIN ON / IDLE"
      color: {r: 0.31, g: 0.88, b: 0.84, a: 1}
    - id: start
      kind: 9
      position: {x: 0.5, y: 0.75}
      label: "2 START / HOLDS"
      color: {r: 0.36, g: 0.91, b: 0.54, a: 1}
    - id: stop
      kind: 9
      position: {x: 0.83, y: 0.75}
      label: "3 STOP / IDLE"
      color: {r: 0.51, g: 0.62, b: 0.72, a: 1}
    - id: loss
      kind: 9
      position: {x: 0.83, y: 0.33}
      label: "4 RUN, THEN OFF"
      color: {r: 0.98, g: 0.34, b: 0.4, a: 1}
    - id: restore
      kind: 9
      position: {x: 0.5, y: 0.33}
      label: "5 RESTORE / IDLE"
      color: {r: 0.31, g: 0.88, b: 0.84, a: 1}
    - id: restart
      kind: 9
      position: {x: 0.17, y: 0.33}
      label: "6 START AGAIN"
      color: {r: 0.36, g: 0.91, b: 0.54, a: 1}
