  levelTitle: Keep in Step
  initialPage: 0
  pages:
  - title: 01 / Build the transport loop
    explanation: Wire supply and return, both PWM signals, each pair of motor leads
      and the four feedback leads. Add follower A and B last for the direction test.
    caption: "12 WIRES  \u2022  TWO MOTORS  \u2022  TWO ENCODERS"
    parts:
    - id: source
      kind: 9
      position: {x: 0.12, y: 0.8}
      label: 5 V + RETURN
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    - id: encoder
      kind: 9
      position: {x: 0.14, y: 0.48}
      label: ENCODER
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: decoder
      kind: 9
      position: {x: 0.82, y: 0.48}
      label: GOVERNOR
      color: {r: 0.99, g: 0.73, b: 0.31, a: 1}
    - id: phaseA
      kind: 9
      position: {x: 0.47, y: 0.64}
      label: MASTER A/B
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: phaseB
      kind: 9
      position: {x: 0.47, y: 0.3}
      label: FOLLOWER A/B
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
