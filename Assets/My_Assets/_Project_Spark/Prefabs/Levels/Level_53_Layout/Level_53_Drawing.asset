  m_Script: {fileID: 11500000, guid: 7dbcf2efd0d400c45bb9124777514e60, type: 3}
  m_Name: Level_53_Drawing
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.UI.VisualTeaching.SparkLevelDrawingAsset
  levelId: level_53
  levelTitle: The Hidden Couple
  initialPage: 0
  pages:
  - title: 01 / Wire both planes
    explanation: Connect both bearing pickups, both actuators and A/B/Z. Install
      W15 last.
    caption: "24 WIRES  \u2022  40 SOCKETS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.53}
      label: LEFT / RIGHT
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.53, y: 0.53}
      label: A / B / Z
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.53}
      label: PLANES A / B
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.53}
      - {x: 0.43, y: 0.53}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.53}
      - {x: 0.75, y: 0.53}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 02 / Discover the couple
    explanation: A twisting couple can produce similar amplitudes at opposite phases.
      Check both bearings before accepting a correction.
    caption: "45 RPM  \u2022  TWO BEARINGS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.53}
      label: LEFT PHASE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.53, y: 0.53}
      label: ROTOR
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.53}
      label: RIGHT PHASE
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.53}
      - {x: 0.43, y: 0.53}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.53}
      - {x: 0.75, y: 0.53}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 03 / Calibrate and solve
    explanation: Each trial measures its effect on both bearings. Solve both corrections
      together and verify both residuals.
    caption: "TRIAL A  \u2022  TRIAL B  \u2022  COMPLEX MATRIX"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.53}
      label: TRIAL A
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.53, y: 0.53}
      label: MATRIX
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.53}
      label: TRIAL B
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.53}
      - {x: 0.43, y: 0.53}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.53}
      - {x: 0.75, y: 0.53}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
  - title: 04 / Certify and recover
    explanation: Verify at speed, undo W15, reconnect it after safe stop, reset and
      verify both bearings again.
    caption: "60 RPM  \u2022  W15 SENSOR LOSS"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.53}
      label: SENSOR LOSS
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.53, y: 0.53}
      label: SAFE STOP
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.53}
      label: RECERTIFY
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.53}
      - {x: 0.43, y: 0.53}
      energized: 0
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - points:
      - {x: 0.57, y: 0.53}
      - {x: 0.75, y: 0.53}
      energized: 0
      color: {r: 1, g: 0.68, b: 0.31, a: 1}
