      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 03 / Implant and activate
    explanation: Implant a masked wafer, activate, then verify depth and sheet resistance.
      Diagnose all three disturbances.
    caption: "16 REGIONS  \u2022  100 DOSE"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: IMPLANT
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: ACTIVATE
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
    - id: output
      kind: 9
      position: {x: 0.82, y: 0.71}
      label: SCAN
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    wires:
    - points:
      - {x: 0.25, y: 0.71}
