      - {x: 0.75, y: 0.71}
      energized: 0
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
  - title: 04 / Restore dosimetry
    explanation: Disconnect W067 during the live raster. Reconnect, zero, verify,
      reset and certify a fresh wafer.
    caption: "W067  \u2022  BEAM BLANKING"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: BLANK
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
      label: RECALIBRATE
      color: {r: 1, g: 0.71, b: 0.31, a: 1}
