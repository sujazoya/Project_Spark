  - title: 03 / Unload momentum and hold two passes
    explanation: Unload excess wheel momentum using the changing field. Align optics
      and qualify both scheduled ground passes.
    caption: "TORQUERS  \u2022  BORESIGHT"
    parts:
    - id: input
      kind: 9
      position: {x: 0.18, y: 0.71}
      label: UNLOAD
      color: {r: 0.18, g: 0.86, b: 0.94, a: 1}
    - id: tracking
      kind: 9
      position: {x: 0.71, y: 0.71}
