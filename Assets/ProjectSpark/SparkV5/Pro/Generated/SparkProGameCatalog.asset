      negativeId: LED_Cathode
    - id: level16_green_led_conducting
      title: Green LED Conducting
      description: Green SparkLED must be forward biased and conducting; fixed binding
        ID led_2.
      kind: ComponentConducting
      componentId: led_2
      terminalId: 
      positiveId: led_2_Anode
      negativeId: led_2_Cathode
    - id: level16_series_current
      title: Correct Series Current
      description: Install 100 ohm R_LIMIT; expect 8-12 mA through both LEDs in series
