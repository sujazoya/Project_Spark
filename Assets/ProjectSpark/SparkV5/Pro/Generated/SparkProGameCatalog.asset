      terminalId: 
      positiveId: Battery_positive
      negativeId: Battery_negative
    - id: level27_diode_forward
      title: Protection Diode Forward
      description: Confirm the diode is forward biased.
      kind: VoltageRange
      componentId: D_ISOLATE_Component
      terminalId: 
      positiveId: D_ISOLATE_Anode
      negativeId: D_ISOLATE_Cathode
    - id: level27_cap_charge
      title: Capacitor Charged
      description: Confirm reservoir capacitor voltage reaches 3.1 to 3.7 V in this
        loaded DC circuit.
      kind: VoltageRange
      componentId: C_RESERVOIR_Component
      terminalId: 
      positiveId: C_RESERVOIR_Positive
      negativeId: C_RESERVOIR_Negative
    - id: level27_led_on
      title: Indicator LED ON
      description: Confirm the indicator LED glows when the capacitor rail supplies
        the load.
      kind: LEDOn
      componentId: led
      terminalId: 
      positiveId: LED_Anode
      negativeId: LED_Cathode
    - id: level27_safe_current
      title: Safe LED Branch Current
      description: Verify approximately 3-6 mA through the 330 ohm LED resistor.
      kind: CurrentRange
      componentId: R_LED_Component
      terminalId: 
      positiveId: R_LED_Input
      negativeId: R_LED_Output
    - id: level27_charge_resistor
