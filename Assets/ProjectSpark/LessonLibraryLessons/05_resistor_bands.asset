  m_Name: 05_resistor_bands
  m_EditorClassIdentifier: Assembly-CSharp:ProjectSpark.UI.VisualTeaching:SparkVisualLesson
  lessonId: 05_resistor_bands
  title: Resistor Color Bands
  goal: Learn the four-band resistance code.
  steps:
  - title: First two digits
    instruction: The first two bands encode significant digits. For example brown-black
      gives 10.
    hint: This is an authored educational example. Compare it to verified measurements
      in your current level.
    requiredVerifiedActionId: 
    advanceWhenVerified: 0
    annotations: []
    schematic:
      caption: CONCEPTUAL / Resistor Color Bands (not live solver data)
      parts:
      - id: 05_resistor_bands_symbol_0
        kind: 1
        position: {x: 0.5, y: 0.56}
        label: Four-band resistor
        color: {r: 0.3, g: 0.88, b: 1, a: 1}
      wires: []
  - title: Multiplier
    instruction: "The third band is a multiplier. Brown-black-brown corresponds to
      100 ohms; brown-black-orange corresponds to 10 k\u03A9."
    hint: This is an authored educational example. Compare it to verified measurements
      in your current level.
    requiredVerifiedActionId: 
    advanceWhenVerified: 0
    annotations: []
    schematic:
      caption: CONCEPTUAL / Resistor Color Bands (not live solver data)
      parts:
      - id: 05_resistor_bands_symbol_0
        kind: 1
        position: {x: 0.5, y: 0.56}
        label: Four-band resistor
        color: {r: 0.3, g: 0.88, b: 1, a: 1}
      wires: []
  - title: Tolerance
    instruction: "The fourth band indicates tolerance, e.g. gold represents \xB15%.
      Check the part's actual bands before making claims about its value."
    hint: This is an authored educational example. Compare it to verified measurements
      in your current level.
    requiredVerifiedActionId: 
    advanceWhenVerified: 0
