{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "d2bb22c61ff74dd69a836bf7774231ed",
    "m_Group": {
        "m_Id": "71b32ddcf4724bf8a40a2495554ee146"
    },
    "m_Name": "PS_RoundedRectSDF (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1057.0,
            "y": -621.0,
            "width": 275.0,
            "height": 44.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "fa3aef38de1343f5836e06cf1bb32498"
        },
        {
            "m_Id": "acc728b30a084e878c3e3371cabcc9af"
        },
        {
            "m_Id": "1966a45e886246099174e522f0a69660"
        },
        {
            "m_Id": "4b108f0581cf4522aa5271937936a389"
        },
        {
            "m_Id": "2d376a99033c4c0fbb429acdb68f2bb8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PS_RoundedRectSDF",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void PS_RoundedRectSDF_float(\r\n    float2 UV,\r\n    float Width,\r\n    float Height,\r\n    float Radius,\r\n    out float Distance)\r\n{\r\n    float2 p = UV - 0.5;\r\n\r\n    float2 halfSize = float2(Width, Height) * 0.5;\r\n\r\n    float2 q = abs(p) - halfSize + Radius;\r\n\r\n    float outsideDistance =\r\n        length(max(q, 0.0));\r\n\r\n    float insideDistance =\r\n        min(max(q.x, q.y), 0.0);\r\n\r\n    Distance =\r\n        outsideDistance +\r\n        insideDistance -\r\n        Radius;\r\n}"
}

