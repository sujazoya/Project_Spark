  m_Name: Level_22
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.Gameplay.SparkLevelDefinition
  levelId: level_21
  displayName: Capacitor Charge - Store the Energy
  description: Build a 5 V RC charging circuit with a 1 kOhm resistor and 1000 uF
    capacitor. Charge the capacitor near 5 V and verify that the charging resistor
    voltage drop settles near zero.
  completionMode: 0
  requiredTargetCount: 3
  requireClosedReturn: 0
  rejectShortCircuit: 1
  rejectTargetShort: 1
  allowIntermediateConnections: 1
  requireMinimumVoltage: 0
  minimumVoltage: 1
  allowAnyConfiguredPowerSource: 1
  powerSources:
  - sourceName: PowerSupply_01
    positiveTerminalId: Battery_positive
    negativeTerminalId: Battery_negative
    nominalVoltage: 5
  targets:
  - targetId: level21_supply
    displayName: 5 V Supply
    description: Verify a healthy 5 V source.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: Battery_positive
    requiredNegativeTerminalId: Battery_negative
    targetComponentId: PowerSupply_01
    minimumVoltage: 4.8
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 5.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level21_capacitor_voltage
    displayName: Capacitor Charged
    description: Verify the capacitor has charged to at least 95% of the 5 V supply.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: C_STORE_Input
    requiredNegativeTerminalId: C_STORE_Output
    targetComponentId: C_STORE_Component
    minimumVoltage: 4.75
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 5.1
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level21_resistor_settled
    displayName: Charging Resistor Settled
    description: Verify the voltage drop across the charging resistor has fallen
      near zero after the capacitor charges.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: R_CHARGE_Input
