  m_Script: {fileID: 11500000, guid: 1581588b391302d4d80156907e5be0fb, type: 3}
  m_Name: Level_13
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.Gameplay.SparkLevelDefinition
  levelId: level_13
  displayName: "Series\u2013Parallel Circuit Challenge"
  description: 'Build a 5 V series-parallel network: fixed 330 ohm R1 in one branch,
    and replaceable R2 in series with fixed 470 ohm R3 in the other. Replace incorrect
    100 ohm R2 with 220 ohm, measure 3.41 V across R3, verify 7.25 mA in the series
    branch and approximately 22.40 mA total source current. Switch off before replacing
    a resistor.'
  completionMode: 0
  requiredTargetCount: 4
  requireClosedReturn: 1
  rejectShortCircuit: 1
  rejectTargetShort: 1
  allowIntermediateConnections: 1
  requireMinimumVoltage: 0
  minimumVoltage: 0
  allowAnyConfiguredPowerSource: 1
  powerSources:
  - sourceName: PowerSupply_01
    positiveTerminalId: Battery_positive
    negativeTerminalId: Battery_negative
    nominalVoltage: 5
  targets:
  - targetId: series_parallel_r1_conducting
    displayName: R1 Parallel Branch Conducting
    description: Fixed 330 ohm R1 must conduct in its own parallel branch.
    targetType: 4
    targetTerminalId: 
    requiredPositiveTerminalId: Resistor_330_Input
    requiredNegativeTerminalId: Resistor_330_Output
    targetComponentId: "Resistor_330_\u03A9"
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 1
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: series_parallel_r2_current
    displayName: R2 Series Branch Current
    description: Installed R2 must carry 7.0-7.5 mA when 220 ohm R2 is in series
      with 470 ohm R3.
    targetType: 6
    targetTerminalId: 
    requiredPositiveTerminalId: R2_Input
    requiredNegativeTerminalId: R2_Output
    targetComponentId: R2_Component
    minimumVoltage: 0
    minimumCurrent: 0.007
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 1
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 1
    maximumCurrent: 0.0075
    useMaximumPower: 0
    maximumPower: 0
  - targetId: series_parallel_r3_voltage
    displayName: R3 Divided Voltage
    description: Fixed 470 ohm R3 must have 3.30-3.50 V across it.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: Resistor_470_Input
    requiredNegativeTerminalId: Resistor_470_Output
    targetComponentId: "Resistor_470_\u03A9"
    minimumVoltage: 3.3
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 1
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 3.5
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: series_parallel_source_current
    displayName: Safe Total Source Current
    description: The source must supply 21.5-23.0 mA with 330 ohm parallel to the
      220+470 ohm series branch.
    targetType: 6
    targetTerminalId: 
    requiredPositiveTerminalId: Battery_positive
    requiredNegativeTerminalId: Battery_negative
    targetComponentId: PowerSupply_01
    minimumVoltage: 0
    minimumCurrent: 0.0215
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 1
    maximumCurrent: 0.023
    useMaximumPower: 0
    maximumPower: 0
  failureMode: 0
  requiredHealthyResistorIds: []
  requireHealthyInstalledResistors: 0
  successOutputIds: []
  failureOutputIds: []
  unlockNextLevelOnCompletion: 1
  unlockedByDefault: 1
