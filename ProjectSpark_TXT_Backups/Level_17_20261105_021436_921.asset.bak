  m_Name: Level_17
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.Gameplay.SparkLevelDefinition
  levelId: level_17
  displayName: "Series\u2013Parallel LED Network"
  description: 'From a switched 5 V supply, install a 100 ohm series resistor in
    Register_Slot_2. After this resistor split into two parallel branches: 330 ohm
    + red LED, and 470 ohm + green LED. Reconnect both LED cathodes to supply negative.
    Check both LEDs, each branch current, and source current. Power off before replacing
    the initial 220 ohm resistor. Current thresholds are nominal and must be checked
    against the actual SparkLED solver.'
  completionMode: 0
  requiredTargetCount: 5
  requireClosedReturn: 1
  rejectShortCircuit: 1
  rejectTargetShort: 1
  allowIntermediateConnections: 1
  requireMinimumVoltage: 0
  minimumVoltage: 0
  allowAnyConfiguredPowerSource: 1
  powerSources:
  - sourceName: PowerSupply_01
    positiveTerminalId: Battery_positive
    negativeTerminalId: Battery_negative
    nominalVoltage: 5
  targets:
  - targetId: level17_red_led_conducting
    displayName: Red LED Conducting
    description: Red LED in the 330 ohm branch conducts.
    targetType: 4
    targetTerminalId: 
    requiredPositiveTerminalId: LED_Anode
    requiredNegativeTerminalId: LED_Cathode
    targetComponentId: led
