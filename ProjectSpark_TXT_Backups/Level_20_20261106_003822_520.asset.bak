    maximumCurrent: 0.0082
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level19_bottom_current
    displayName: BOTTOM Resistor Current ~5.24 mA
    description: Current through the 470 ohm BOTTOM branch.
    targetType: 6
    targetTerminalId: 
    requiredPositiveTerminalId: R_BOTTOM_Input
    requiredNegativeTerminalId: R_BOTTOM_Output
    targetComponentId: R_BOTTOM_Component
    minimumVoltage: 0
