    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 1
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 1
    maximumCurrent: 0.0056
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level19_load_current
    displayName: LOAD Resistor Current ~2.46 mA
    description: Current through the 1 kohm LOAD branch in parallel with the BOTTOM
      resistor.
    targetType: 6
    targetTerminalId: 
    requiredPositiveTerminalId: R_LOAD_Input
    requiredNegativeTerminalId: R_LOAD_Output
    targetComponentId: R_LOAD_Component
