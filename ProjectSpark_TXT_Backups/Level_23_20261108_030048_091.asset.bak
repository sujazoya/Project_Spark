  m_Name: Level_23
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.Gameplay.SparkLevelDefinition
  levelId: level_22
  displayName: One Way Only - Diode Direction
  description: Build a 5 V forward-biased diode and green LED indicator circuit.
    Identify anode and cathode, place the 1N4007 correctly, and confirm safe LED
    current.
  completionMode: 0
  requiredTargetCount: 4
  requireClosedReturn: 1
  rejectShortCircuit: 1
  rejectTargetShort: 1
  allowIntermediateConnections: 1
  requireMinimumVoltage: 0
  minimumVoltage: 1
  allowAnyConfiguredPowerSource: 1
  powerSources:
  - sourceName: PowerSupply_01
    positiveTerminalId: Battery_positive
    negativeTerminalId: Battery_negative
    nominalVoltage: 5
  targets:
  - targetId: level22_supply
    displayName: 5 V Supply
    description: Verify the 5 V source.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: Battery_positive
    requiredNegativeTerminalId: Battery_negative
    targetComponentId: PowerSupply_01
    minimumVoltage: 4.8
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 5.2
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level22_diode_forward
    displayName: Forward Diode Voltage
    description: Verify a forward voltage drop across the 1N4007 diode. Confirm direction
      by also checking illuminated LED and current.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: D_PROTECT_Anode
    requiredNegativeTerminalId: D_PROTECT_Cathode
    targetComponentId: D_PROTECT_Component
    minimumVoltage: 0.45
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 1
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level22_led_on
    displayName: Green LED ON
    description: Verify that the green LED is illuminated in the forward-biased circuit.
    targetType: 3
    targetTerminalId: 
    requiredPositiveTerminalId: LED_Anode
    requiredNegativeTerminalId: LED_Cathode
    targetComponentId: led
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: level22_safe_current
    displayName: Safe Series Current
    description: Verify 5 to 8 mA through the 330 ohm resistor.
    targetType: 6
    targetTerminalId: 
    requiredPositiveTerminalId: R_LIMIT_Input
    requiredNegativeTerminalId: R_LIMIT_Output
    targetComponentId: R_LIMIT_Component
    minimumVoltage: 0
    minimumCurrent: 0.005
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 1
    maximumCurrent: 0.008
    useMaximumPower: 0
    maximumPower: 0
