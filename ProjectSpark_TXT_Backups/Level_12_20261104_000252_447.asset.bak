  m_Name: Level_12
  m_EditorClassIdentifier: Assembly-CSharp::ProjectSpark.Gameplay.SparkLevelDefinition
  levelId: level_11
  displayName: Power Distribution Challenge
  description: Restore a safe 5 V three-branch parallel power network. Replace the
    overloaded 100 ohm R2 with 220 ohm; verify approximately 22.73 mA through R2,
    5.00 V across R2, and 48.52 mA total source current. Turn the switch off before
    replacing resistors.
  completionMode: 0
  requiredTargetCount: 4
  requireClosedReturn: 1
  rejectShortCircuit: 1
  rejectTargetShort: 1
  allowIntermediateConnections: 1
  requireMinimumVoltage: 0
  minimumVoltage: 0
  allowAnyConfiguredPowerSource: 1
  powerSources:
  - sourceName: PowerSupply_01
    positiveTerminalId: Battery_positive
    negativeTerminalId: Battery_negative
    nominalVoltage: 5
  targets:
  - targetId: distribution_r1_conducting
    displayName: R1 Branch Conducting
    description: Fixed 330 ohm R1 branch must conduct.
    targetType: 4
    targetTerminalId: 
    requiredPositiveTerminalId: Resistor_330_Input
    requiredNegativeTerminalId: Resistor_330_Output
    targetComponentId: "Resistor_330_\u03A9"
    minimumVoltage: 0
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 1
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: distribution_r2_current
    displayName: R2 Current Controlled
    description: Replace 100 ohm R2 with 220 ohm so branch current is 21-24 mA.
    targetType: 6
    targetTerminalId: 
    requiredPositiveTerminalId: R2_Input
    requiredNegativeTerminalId: R2_Output
    targetComponentId: R2_Component
    minimumVoltage: 0
    minimumCurrent: 0.021
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 1
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 1
    maximumCurrent: 0.024
    useMaximumPower: 0
    maximumPower: 0
  - targetId: distribution_r2_voltage
    displayName: R2 Supply Voltage
    description: R2 has 4.90-5.10 V across it.
    targetType: 5
    targetTerminalId: 
    requiredPositiveTerminalId: R2_Input
    requiredNegativeTerminalId: R2_Output
    targetComponentId: R2_Component
    minimumVoltage: 4.9
    minimumCurrent: 0
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 1
    inverted: 0
    useMaximumVoltage: 1
    maximumVoltage: 5.1
    useMaximumCurrent: 0
    maximumCurrent: 0
    useMaximumPower: 0
    maximumPower: 0
  - targetId: distribution_source_current
    displayName: Total Current Safe
    description: Source current should be 47-50 mA with 330, 220 and 470 ohm parallel
      branches.
    targetType: 6
    targetTerminalId: 
    requiredPositiveTerminalId: Battery_positive
    requiredNegativeTerminalId: Battery_negative
    targetComponentId: PowerSupply_01
    minimumVoltage: 0
    minimumCurrent: 0.047
    minimumPower: 0
    requireElectricalEnabled: 1
    requireConduction: 0
    inverted: 0
    useMaximumVoltage: 0
    maximumVoltage: 0
    useMaximumCurrent: 1
    maximumCurrent: 0.05
    useMaximumPower: 0
    maximumPower: 0
