  levelId: level_36
  levelTitle: Thermal Interlock
  initialPage: 0
  pages:
  - title: 01 / Wire the sensor divider
    explanation: "W01 Battery_positive \u2192 PULLUP_IN. W02 PULLUP_OUT \u2192 SENSOR_IN.
      W03 SENSOR_RETURN \u2192 Battery_negative. Cool NTC is 15 k\u03A9 and SENSE
      is about 3.00 V. The pull-up limits sensor current even in the short test."
    caption: "5 V \u2192 10 k\u03A9 \u2192 SENSE \u2192 NTC \u2192 RETURN"
    parts:
    - id: positive
      kind: 9
      position: {x: 0.09, y: 0.56}
      label: BATTERY +
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: pullup
      kind: 1
      position: {x: 0.31, y: 0.56}
      label: "10 k\u03A9 PULL-UP"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: sense
      kind: 9
      position: {x: 0.5, y: 0.71}
      label: SENSE 3.00 V
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: ntc
      kind: 1
      position: {x: 0.69, y: 0.56}
      label: "NTC \xB7 15 k\u03A9"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: negative
      kind: 9
      position: {x: 0.91, y: 0.56}
      label: "BATTERY \u2212"
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    wires:
    - points:
      - {x: 0.09, y: 0.56}
      - {x: 0.265, y: 0.56}
      energized: 0
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - points:
      - {x: 0.355, y: 0.56}
      - {x: 0.645, y: 0.56}
      energized: 0
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - points:
      - {x: 0.5, y: 0.56}
      - {x: 0.5, y: 0.68}
      energized: 0
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - points:
