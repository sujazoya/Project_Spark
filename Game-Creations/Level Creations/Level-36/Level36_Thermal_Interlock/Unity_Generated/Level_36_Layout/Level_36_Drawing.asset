  - title: 03 / Test both sides of the warm band
    explanation: HOT reads 1.60 V and starts cooling. WARM reads 2.25 V and keeps
      cooling on. COOL reads 3.00 V and stops cooling. WARM again reads 2.25 V with
      cooling off. The same voltage keeps whichever state was already active.
    caption: "FAN ON BELOW 2.00 V  \u2022  FAN OFF ABOVE 2.70 V"
    parts:
    - id: positive
      kind: 9
      position: {x: 0.09, y: 0.56}
      label: BATTERY +
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: pullup
      kind: 1
      position: {x: 0.31, y: 0.56}
      label: "10 k\u03A9 PULL-UP"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: sense
      kind: 9
      position: {x: 0.5, y: 0.71}
      label: SENSE 2.25 V
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: ntc
      kind: 1
      position: {x: 0.69, y: 0.56}
      label: "NTC \xB7 8.2 k\u03A9"
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - id: negative
      kind: 9
      position: {x: 0.91, y: 0.56}
      label: "BATTERY \u2212"
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
    wires:
    - points:
      - {x: 0.09, y: 0.56}
      - {x: 0.265, y: 0.56}
      energized: 0
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - points:
      - {x: 0.355, y: 0.56}
      - {x: 0.645, y: 0.56}
      energized: 0
      color: {r: 0.24, g: 0.87, b: 0.8, a: 1}
    - points:
