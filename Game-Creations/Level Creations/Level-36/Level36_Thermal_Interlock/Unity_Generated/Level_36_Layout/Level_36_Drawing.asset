      - {x: 0.91, y: 0.56}
      energized: 0
      color: {r: 0.28, g: 0.69, b: 1, a: 1}
  - title: 02 / Wire the three outputs
    explanation: "W04 + \u2192 FAN_SW_IN, W05 FAN_SW_OUT \u2192 FAN_A, W06 FAN_B
      \u2192 \u2212. W07 + \u2192 HEAT_SW_IN, W08 HEAT_SW_OUT \u2192 HEATER_IN, W09
      HEATER_OUT \u2192 \u2212. W10 + \u2192 FAULT_SW_IN, W11 FAULT_SW_OUT \u2192
      LED_R_IN, W12 LED_R_OUT \u2192 LED_A, W13 LED_K \u2192 \u2212."
    caption: FAN, HEATER, AND FAULT LED BRANCHES
    parts:
    - id: positive
      kind: 9
      position: {x: 0.09, y: 0.54}
      label: BATTERY +
      color: {r: 0.98, g: 0.35, b: 0.42, a: 1}
    - id: fan-contact
      kind: 9
      position: {x: 0.29, y: 0.78}
